# Browser client (Vite exposes only VITE_* values to the client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Server-side Supabase Auth middleware/client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Optional: only for trusted server-side admin operations. Never add a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Drizzle migration tooling only.
# LOVABLE_DB_MIGRATION_URL=
